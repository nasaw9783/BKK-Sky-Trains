<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notif_card_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="9dp">

    <!-- Header Row: Pin Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/notif_pin_pill_bg"
            android:padding="4dp"
            android:src="@drawable/ic_notif_pin"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="ตรวจพบสถานีใกล้ตัวคุณ"
                android:textColor="#F8FAFC"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_header_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="เวลาขบวนรถและชานชาลาแบบเรียลไทม์"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Station Row Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/notif_station_box_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="25dp">

            <ImageView
                android:id="@+id/notif_station_key_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignStart="@+id/notif_station_key"
                android:layout_alignEnd="@+id/notif_station_key"
                android:layout_alignTop="@+id/notif_station_key"
                android:layout_alignBottom="@+id/notif_station_key"
                android:scaleType="fitXY"
                android:src="@drawable/notif_badge_bg"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/notif_station_key"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="36dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center"
                android:text="E23"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_station_name_th"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="เคหะฯ"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_station_name_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Kheha"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="อยู่ที่สถานี"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_distance_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จากตำแหน่งคุณ"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Platforms & Live Arrivals Section (No train map) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/notif_plat_section_bg"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_notif_train"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/notif_plat_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="ชานชาลา &amp; เวลาเดินรถ"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/notif_dot_live"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/notif_status_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="กำลังเข้า / นับถอยหลังสด"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 2 Columns: Platform 1 & Platform 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Platform 1 Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3.5dp"
                android:background="@drawable/notif_plat_card_bg"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/notif_plat1_num_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/notif_badge_bg"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/notif_plat1_num"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/notif_plat1_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="ชานชาลา 1 · ไปทาง"
                            android:textColor="#94A3B8"
                            android:textSize="8.5sp" />

                        <TextView
                            android:id="@+id/notif_plat1_dest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="เคหะฯ"
                            android:textColor="#F8FAFC"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notif_plat1_time1"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/notif_time_main_arriving_bg"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp"
                        android:text="กำลังเข้า"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/notif_plat1_time2"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:background="@drawable/notif_time_sub_bg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="6 นาที"
                            android:textColor="#CBD5E1"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/notif_plat1_time3"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/notif_time_sub_bg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="12 นาที"
                            android:textColor="#CBD5E1"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Platform 2 Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3.5dp"
                android:background="@drawable/notif_plat_card_bg"
                android:orientation="vertical"
                android:padding="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="16dp"
                        android:layout_height="16dp">

                        <ImageView
                            android:id="@+id/notif_plat2_num_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/notif_badge_bg"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/notif_plat2_num"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/notif_plat2_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="ชานชาลา 2 · ไปทาง"
                            android:textColor="#94A3B8"
                            android:textSize="8.5sp" />

                        <TextView
                            android:id="@+id/notif_plat2_dest"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="คูคต"
                            android:textColor="#F8FAFC"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notif_plat2_time1"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/notif_time_main_bg"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp"
                        android:text="3 นาที"
                        android:textColor="#A3E635"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/notif_plat2_time2"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:background="@drawable/notif_time_sub_bg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="8 นาที"
                            android:textColor="#CBD5E1"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/notif_plat2_time3"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/notif_time_sub_bg"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="14 นาที"
                            android:textColor="#CBD5E1"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
