<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Pin, Title, Distance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ตรวจพบสถานีใกล้ตัวคุณ"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="501 ม."
            android:textColor="#10b981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Station Info Row: Badge + Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_station_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="YL20"
            android:textColor="#0f172a"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_station_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ศรีด่าน"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Platforms Grid (2 columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Platform 1 Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_plat_bg"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/widget_plat1_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 ไปสำโรง"
                android:textColor="#cbd5e1"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_plat1_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="กำลังเข้า"
                android:textColor="#f43f5e"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Platform 2 Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_plat_bg"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/widget_plat2_dest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2 ไปลาดพร้าว"
                android:textColor="#cbd5e1"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_plat2_time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="2 นาที"
                android:textColor="#f59e0b"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
